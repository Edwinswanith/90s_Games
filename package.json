{
  "name": "theru-party",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config apps/web/vite.config.ts && node scripts/compress.mjs && esbuild apps/server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=apps/server/dist/index.mjs",
    "start:local": "node apps/server/dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node tests/e2e/journeys.mjs",
    "test:load": "node --import tsx tests/load/session.ts",
    "setup": "node scripts/setup.mjs",
    "local": "node scripts/local.mjs",
    "test:impairment": "node tests/e2e/impairment.mjs",
    "test:soak": "vitest run tests/unit/cups.test.ts",
    "format": "prettier --write apps packages tests scripts --ignore-path .prettierignore"
  },
  "dependencies": {
    "@colyseus/core": "0.18.11",
    "@colyseus/schema": "5.0.27",
    "@colyseus/sdk": "0.18.2",
    "@colyseus/ws-transport": "0.18.2",
    "@dimforge/rapier3d-compat": "0.20.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "@react-three/fiber": "9.7.0",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.27.3",
    "eslint": "9.39.1",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
